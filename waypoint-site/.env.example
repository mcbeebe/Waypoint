# waypoint-site environment variables
# Copy to .env.local for local dev; set the production values in the Vercel
# project's Environment Variables (Production scope).

# GA4 Measurement ID (e.g. G-XXXXXXXXXX). OPTIONAL — the production ID is
# committed in BaseLayout.astro (it is public; gtag.js publishes it in every
# page's markup). Set this only to point a build at a different property.
# See docs/analytics-taxonomy.md (D3, "Providers").
GA_MEASUREMENT_ID=
