---
/**
 * Regional Center field guides (regionalCenters collection — the D11 data
 * spine). The not-affiliated notice + contact verification date render from
 * frontmatter on every page (compliance components spec).
 */
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import NoticeBox from '../../components/NoticeBox.astro';
import { visibleEntries } from '../../lib/content';

export async function getStaticPaths() {
  const centers = await visibleEntries('regionalCenters');
  return centers.map((entry) => ({
    params: { rc: entry.data.rcId },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const verified = d.verifiedAsOf.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

<ArticleLayout
  title={d.title}
  description={d.description}
  heading={d.title}
  crumbs={[{ name: 'Regional Centers', href: '/guides/regional-centers/' }, { name: d.rcName }]}
  locale={d.locale}
  status={d.status}
  author={d.author}
  review={d.review}
  datePublished={d.datePublished}
  dateModified={d.dateModified}
  changelog={d.changelog}
  disclaimerVariant={d.disclaimerVariant}
  noindex={d.noindex}
  slug={`regional-centers/${d.rcId}`}
  pillar="regional-centers"
>
  <NoticeBox slot="notice">
    Waypoint is an independent guide — not affiliated with {d.rcName}, DDS, or any government
    agency. Contacts verified as of {verified}.
  </NoticeBox>
  <Content />
</ArticleLayout>
