---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — Waypoint"
  description="That page isn't here. Start from the guides, the tools, or the home page — everything on Waypoint is free and open."
  noindex={true}
>
  <div class="container wrap">
    <span class="eyebrow">404</span>
    <h1>That page isn't on the map.</h1>
    <p>
      The link may be old, or the page may not have published yet. Everything here is free
      and open — start from the home page and you're two clicks from any guide.
    </p>
    <p><a class="btn" href="/">Back to the start →</a></p>
  </div>
</BaseLayout>

<style>
  .wrap {
    padding: 72px 24px 40px;
    max-width: 640px;
  }
  .eyebrow {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-pine);
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 10px 0 12px;
  }
  .btn {
    display: inline-block;
    background: var(--color-pine);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    border-radius: 12px;
    padding: 11px 20px;
  }
  .btn:hover {
    background: var(--color-pine-deep);
  }
</style>

<script>
  // 404 beacon per docs/analytics-taxonomy.md
  // @ts-ignore
  window.plausible?.('not_found', { props: { path: location.pathname } });
</script>
