---
/**
 * The "why the app" page (D13 in the build plan: /product/ was reserved for
 * this from Phase 0, never built until now). Explains what the app does and
 * why it's worth paying for when every guide, tool, and letter on this site
 * is free — the direct comparison a family asks before they sign up.
 *
 * Mocked up and approved as a Claude Design canvas before this file was
 * written, per the owner's "plan & mock up first for new user-facing
 * content" rule (CLAUDE.md). Hero copy and the "What do I do? -> Here's
 * what to do next" framing are the owner's own elevator pitch, used near
 * verbatim.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HandoffCTA from '../components/HandoffCTA.astro';
import OneLoop from '../components/OneLoop.astro';
import GuideVsApp from '../components/GuideVsApp.astro';
import WithoutWith from '../components/WithoutWith.astro';
import PhoneFrame from '../components/showcase/PhoneFrame.astro';
import { appStartUrl } from '../lib/appLinks';

const heroHref = appStartUrl({ slug: 'product', cta: 'product-hero' });
const heroProps = JSON.stringify({ slug: 'product', locale: 'en', cta_id: 'product-hero' });
---

<BaseLayout
  title="What the Waypoint app does — and why it's not just another guide"
  description="Waypoint is the GPS for navigating disability services: an AI-powered action plan, deadline tracking, and letter drafting for California families — grounded in the same laws as our free guides."
  ogSlug="/product/"
>
  <div class="hero">
    <div class="container">
      <span class="eyebrow">The Waypoint app</span>
      <h1>Waypoint is the GPS for navigating disability services.</h1>
      <p class="lede">
        When your child is diagnosed with autism, cerebral palsy, or another developmental
        disability, you're handed a maze — Regional Centers, IEPs, Medi-Cal, SSI — and told to
        figure it out yourself. Waypoint's AI gives California parents clear, personalized next
        steps, grounded in the laws that protect their child's rights, from the Lanterman Act to
        IDEA. Because families shouldn't need to become disability-law experts just to get their
        child the support they're entitled to.
      </p>
      <div class="hero-actions">
        <a
          class="btn on-dark"
          href={heroHref}
          data-wp-event="app_signup_click"
          data-wp-props={heroProps}
        >
          Start free →
        </a>
        <a class="btn ghost-dark" href="#inside">See what's inside</a>
      </div>
    </div>
  </div>

  <div class="section" style="background:var(--color-paper);">
    <div class="container">
      <span class="eyebrow">The alternative is hours</span>
      <h2 class="h">Without Waypoint, you're the one doing the searching.</h2>
      <p class="sub">
        Google, Reddit threads, Facebook groups, PDFs from three different agencies — piecing
        together rules that change by county, hoping you didn't miss a deadline three weeks ago.
        That's not a knock on you. That's the system. Waypoint is built to be the other way
        around.
      </p>
      <WithoutWith
        without={['Hours of searching before you even know what question to ask', "Advice from a stranger's situation, a different county, a different year", "You find out about a deadline after it's already passed", "Nobody's watching your case but you"]}
        withWaypoint={['The next step, before you have to ask for it', "Advice grounded in your child's age, diagnosis, and county", "A reminder before the clock runs out — and again if you don't act", 'One quarterback for the whole case, not a library waiting to be searched']}
      />
      <p class="pull-quote">Waypoint turns <em>"What do I do?"</em> into <em>"Here's what to do next."</em></p>
    </div>
  </div>

  <div class="section on-white">
    <div class="container">
      <span class="eyebrow">The honest comparison</span>
      <h2 class="h">Why not just read the guides?</h2>
      <p class="sub">
        Good question — every guide on this site is free forever, and we mean that. Here's the
        actual difference, one situation at a time.
      </p>

      <GuideVsApp />
    </div>
  </div>

  <div class="section" id="inside" style="background:var(--color-paper);">
    <div class="container">
      <span class="eyebrow">What's actually inside</span>
      <h2 class="h">A tour of what the app does, one screen at a time.</h2>
      <p class="sub">
        Every screen below is a sample with a fictional family, built from what the app actually
        shows.
      </p>

      <div class="tour">
        <div class="tour-row">
          <PhoneFrame label="Sample Navigator answer about an assessment request, with Your right and Watch out cards." appBar="Navigator">
            <div class="tour-q">Can I ask for an assessment before the next IEP meeting?</div>
            <div class="ms-card">Yes. Put the request in writing so the timeline starts.</div>
            <div class="ms-card tour-right"><b>YOUR RIGHT</b> An assessment plan within 15 calendar days of the district receiving it (Ed Code §56321).</div>
            <div class="ms-card tour-watch"><b>WATCH OUT</b> If the district says no, ask for that in writing.</div>
          </PhoneFrame>
          <div class="tour-copy">
            <span class="tour-step">1 · AI Navigator</span>
            <h3>Ask anything about your child's services</h3>
            <p>
              It knows your child's age, diagnosis, county and Regional Center. Each answer
              separates your right, what's good to know and what to watch out for, and cites the law
              where it applies. 30 messages a month are free; Premium is unlimited.
            </p>
          </div>
        </div>

        <div class="tour-row tour-flip">
          <PhoneFrame label="Sample Home card: the answer on Maya's evaluation request is due in 4 days, with a follow-up one tap away.">
            <div class="ms-card ms-hero">
              <span class="ms-pill ms-soon">CLOCK RUNNING — 4 DAYS LEFT</span>
              <div class="ms-title">An answer on Special education evaluation request is due Oct 16</div>
              <div class="ms-muted">Because you asked on Oct 1 and the law gives them a fixed window. <b>Ed Code §56321</b></div>
              <div class="ms-btn">Draft the follow-up</div>
              <div class="ms-muted tour-later">Not today — show the next thing</div>
            </div>
          </PhoneFrame>
          <div class="tour-copy">
            <span class="tour-step">2 · Home</span>
            <h3>One thing for today, before you have to ask</h3>
            <p>
              Home watches the Regional Center and school clocks your requests start, plus the dates
              you add. In the days before an answer is due it says so, with a follow-up one tap
              away. Not today? It shows the next thing.
            </p>
          </div>
        </div>

        <div class="tour-row">
          <PhoneFrame label="Sample follow-up email in the Friendly and Warm tone, with Send now with Gmail and Open in Mail app buttons." appBar="Letters" tab="Tools">
            <div class="ms-chips tour-tones"><span class="on">Friendly &amp; Warm</span><span>Professional &amp; Clear</span><span>Strong &amp; Direct</span></div>
            <div class="ms-card tour-letter">
              Hi Ms. Lopez, I wanted to check in on Maya's assessment plan. I sent my request on
              October 1. Could you let me know when it might be ready?
            </div>
            <div class="ms-btn">📨 Send now with Gmail — replies tracked</div>
            <div class="ms-btn ms-outline">Open in Mail app</div>
          </PhoneFrame>
          <div class="tour-copy">
            <span class="tour-step">3 · Letters</span>
            <h3>The friendly email, already written</h3>
            <p>
              Requests and follow-ups, filled in with your child's name, the date and the citation.
              The first ask is friendly; you choose when to firm it up. Send it with your
              own Gmail and replies show up next to the request, or open it in any mail app. Drafts
              in English, Spanish or Vietnamese.
            </p>
          </div>
        </div>

        <div class="tour-row tour-flip">
          <PhoneFrame label="Sample IEP review: three goals rated Strong, Adequate and Weak, with suggested wording." appBar="IEP review" tab="Tools">
            <div class="ms-title">Maya's IEP · 3 goals</div>
            <div class="ms-card tour-goal"><span>Reading fluency</span><b class="g-strong">Strong</b></div>
            <div class="ms-card tour-goal"><span>Written expression</span><b class="g-ok">Adequate</b></div>
            <div class="ms-card tour-goal"><span>Self-regulation</span><b class="g-weak">Weak</b></div>
            <div class="ms-muted tour-suggest">Suggested wording: "…as measured by weekly teacher data."</div>
          </PhoneFrame>
          <div class="tour-copy">
            <span class="tour-step">4 · Documents and IEP review</span>
            <h3>Every report in one place, and the IEP read for you</h3>
            <p>
              Upload a PDF or a photo of the page. Premium reads an IEP, rates each goal, suggests
              stronger wording, compares it with last year's when you add that one too, and builds
              your meeting questions.
            </p>
          </div>
        </div>

        <div class="tour-row">
          <PhoneFrame label="Sample plan: four school steps, one checked off." appBar="Your plan · School" tab="Plan">
            <div class="ms-card tour-step-row tour-done">Ask for an evaluation in writing</div>
            <div class="ms-card tour-step-row">Ask for typing as a writing accommodation</div>
            <div class="ms-card tour-step-row">Request last year's progress reports</div>
            <div class="ms-card tour-step-row">Make my meeting list</div>
          </PhoneFrame>
          <div class="tour-copy">
            <span class="tour-step">5 · Your plan</span>
            <h3>A plan built for your child, not a generic checklist</h3>
            <p>
              Steps from your child's age, diagnosis and where things stand with the Regional
              Center, school and insurance. Save a step from a Navigator answer, and check them off
              as you go.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="section on-white">
    <div class="container narrow">
      <span class="eyebrow">How it actually works</span>
      <h2 class="h">One loop, every time something changes.</h2>
      <p class="sub">
        Waypoint isn't a form you fill out once. Your case moves — a reply comes in, a deadline
        passes, a new stage of the process opens — and every time it does, you're back at the
        start of the same four moves.
      </p>

      <OneLoop showClose />
    </div>
  </div>

  <div class="section" style="background:var(--color-paper); padding-top:0;">
    <div class="container">
      <div class="trust-strip">
        <span class="check" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </span>
        <p>
          The app isn't a paywalled black box. Every clock and every citation it uses is the same
          one published, for free, in <a href="/guides/">the guides</a> — so you can always check
          its work yourself.
        </p>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="container narrow">
      <HandoffCTA
        heading="Free to start. Honest when you need more."
        body="Limited AI access and every guide, free forever. Premium is $9.99/mo or $99/yr — first 30 days free, and always free if your child gets SSI or money's tight. See pricing →"
        action="Start free →"
        slug="product"
        cta="product-footer"
      />
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(165deg, #22303a 0%, #123f39 55%, #0f766e 135%);
    color: #eef6f1;
    padding: 76px 0 64px;
  }
  .hero .eyebrow {
    color: #9fe8db;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 2.7rem);
    line-height: 1.2;
    color: #ffffff;
    margin: 14px 0 18px;
    max-width: 21ch;
  }
  .hero .lede {
    font-size: 1.1rem;
    color: #d3e7de;
    max-width: 58ch;
    margin: 0 0 30px;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .section .h {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.9rem;
    margin: 8px 0 14px;
  }

  .pull-quote {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.7rem;
    color: var(--color-ink);
    text-align: center;
    max-width: 26ch;
    margin: 44px auto 0;
    line-height: 1.35;
  }
  .pull-quote em {
    font-style: normal;
    color: var(--color-pine);
  }

  /* tour: sample screen beside each feature, alternating sides */
  .tour {
    display: flex;
    flex-direction: column;
    gap: 56px;
    margin-top: 36px;
  }
  .tour-row {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }
  .tour-flip {
    grid-template-columns: minmax(0, 1fr) 300px;
  }
  .tour-flip > :global(.phone) {
    order: 2;
  }
  /* The tour's screens are short; the homepage's 560px phone left them half empty. */
  .tour :global(.phone-screen) {
    height: 420px;
  }
  .tour-step {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-pine);
  }
  .tour-copy h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    margin: 8px 0 10px;
  }
  .tour-copy p {
    margin: 0;
    max-width: 52ch;
  }
  .tour-q {
    align-self: flex-end;
    background: var(--color-pine);
    color: #fff;
    border-radius: 12px 12px 2px 12px;
    padding: 8px 10px;
    font-size: 11px;
    margin-left: 30px;
  }
  .tour-right,
  .tour-watch,
  .tour-letter {
    font-size: 11px;
    line-height: 1.45;
  }
  .tour-right {
    background: var(--color-sage-tint);
  }
  .tour-watch {
    background: var(--color-amber-soft);
  }
  .tour-right b,
  .tour-watch b {
    font-size: 9px;
    letter-spacing: 0.08em;
    display: block;
  }
  .tour-tones .on {
    background: var(--color-pine);
    border-color: var(--color-pine);
    color: #fff;
  }
  .tour-later {
    text-align: center;
    margin-top: 7px;
  }
  .tour-goal {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
  }
  .tour-goal b {
    font-size: 10px;
    padding: 1px 6px;
    border-radius: 5px;
  }
  .g-strong {
    background: var(--color-sage-tint);
    color: var(--color-pine-deep);
  }
  .g-ok {
    background: var(--color-amber-soft);
    color: var(--color-amber);
  }
  .g-weak {
    background: var(--color-urgent-tint);
    /* Darker than --color-urgent: that is 4.41:1 on its tint at 10px (axe). */
    color: #9a3412;
  }
  .tour-suggest {
    font-style: italic;
  }
  .tour-step-row {
    font-size: 11px;
    padding-left: 26px;
    position: relative;
  }
  .tour-step-row::before {
    content: '';
    position: absolute;
    left: 9px;
    top: 50%;
    width: 10px;
    height: 10px;
    margin-top: -6px;
    border: 1.5px solid var(--color-pine);
    border-radius: 3px;
  }
  .tour-done {
    color: var(--color-ink-soft);
    text-decoration: line-through;
  }
  .tour-done::before {
    background: var(--color-pine);
  }
  @media (max-width: 800px) {
    .tour-row,
    .tour-flip {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      justify-items: center;
    }
    .tour-flip > :global(.phone) {
      order: 0;
    }
  }

  /* trust strip */
  .trust-strip {
    display: flex;
    align-items: center;
    gap: 18px;
    background: var(--color-pine-tint);
    border: 1px solid var(--color-pine-tint-pressed);
    border-radius: 14px;
    padding: 22px 26px;
  }
  .trust-strip .check {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--color-pine);
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .trust-strip p {
    margin: 0;
    color: var(--color-pine-deep);
    font-size: 0.95rem;
  }
  .trust-strip a {
    font-weight: 700;
  }
</style>
