---
/**
 * Homepage. Content-backed card links render only when their target exists
 * in this build (src/lib/content.ts); gated cards show an honest "publishing
 * soon" state instead of a dead link.
 *
 * Initiative 013 (owner go 2026-10-08): the page now SHOWS the app working —
 * code-built screens with a fictional family ("Maya"), never a real one — and
 * gives free help up front with the browser-only IEP goal check. Headline
 * approved by the owner the same day.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import EmpathyCallout from '../components/EmpathyCallout.astro';
import HandoffCTA from '../components/HandoffCTA.astro';
import GoalCheck from '../components/GoalCheck.astro';
import PhoneFrame from '../components/showcase/PhoneFrame.astro';
import AppShowcase from '../components/showcase/AppShowcase.astro';
import '../styles/showcase.css';
import { visibleContentUrls } from '../lib/content';
import { appStartUrl } from '../lib/appLinks';
import { organizationJsonLd } from '../lib/jsonld';

const urls = await visibleContentUrls();
const has = (u: string) => urls.has(u);

const heroHref = appStartUrl({ slug: 'home', cta: 'hero' });
const heroProps = JSON.stringify({ slug: 'home', locale: 'en', cta_id: 'hero' });
const showcaseHref = appStartUrl({ slug: 'home', cta: 'home-showcase' });
const showcaseProps = JSON.stringify({ slug: 'home', locale: 'en', cta_id: 'home-showcase' });

// "Waypoint speaks first": status-first wording per the escalation tone rule
// (CLAUDE.md) — the answer is past due; nobody is said to have failed.
const timeline = [
  {
    when: 'Day 0',
    title: 'You send the request',
    body: 'Waypoint drafts it and you send it. The district now has 15 calendar days to send an assessment plan.',
  },
  {
    when: 'Day 12',
    title: 'A heads-up',
    body: 'Nothing back yet. A gentle note, with nothing you need to do today.',
    push: 'The assessment plan is due in 3 days. Nothing has come in yet.',
  },
  {
    when: 'Day 16',
    title: 'The answer is past due',
    body: 'It moves to the top of Home, with a friendly follow-up already drafted.',
    push: "An answer on Maya's assessment plan is past due. Want to send a quick follow-up?",
  },
  {
    when: 'If needed',
    title: 'Firmer, one step at a time',
    body: 'The tone only firms up if asks go unanswered, and only when you choose.',
  },
];

const pillars = [
  {
    title: 'Regional Centers',
    body: 'Eligibility, the 120-day clock, IPP meetings, respite, and appeals under the Lanterman Act.',
    href: '/guides/regional-centers/',
    label: 'Pillar guide →',
  },
  {
    title: 'School & IEPs',
    body: 'Request an evaluation, IEP vs 504, what to sign, and the dispute ladder — with copy-paste letters.',
    href: '/letters/iep-evaluation-request/',
    label: 'Get the letter →',
  },
  {
    title: 'Money & benefits',
    body: 'Medi-Cal institutional deeming, IHSS protective supervision, SSI for children, and other resources.',
    href: '/guides/benefits/',
    label: 'Explore all benefits →',
  },
  {
    title: 'Insurance & therapies',
    body: "What your plan must cover for prescribed treatment, appealing denials, and the DMHC Independent Medical Review.",
    href: '/guides/',
    label: 'Browse guides →',
    always: true,
  },
  {
    title: 'First steps (0–5)',
    body: 'Early Start, getting an evaluation without the year-long wait, and the turning-three transition.',
    href: '/start/',
    label: 'First 100 Days →',
  },
  {
    title: 'Free tools',
    body: 'The IEP goal check, the SSI deeming calculator, your Regional Center finder, and template letters — no email required.',
    href: '/tools/iep-goal-check/',
    label: 'Try a tool →',
    always: true,
  },
];
---

<BaseLayout
  title="Waypoint — the next step for your child, before you have to ask"
  description="Waypoint helps California families of children with disabilities navigate Regional Centers, IEPs, Medi-Cal, and SSI — an AI navigator, drafted letters, deadline reminders, and free tools like the IEP goal check."
>
  <div class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">For California families</span>
        <h1>The next step for your child, <em>before you have to ask.</em></h1>
        <p class="lede">
          Waypoint reads your child's IEP, answers your questions with the law behind them, drafts
          the friendly email, and keeps track of every clock: Regional Center, school, Medi-Cal,
          IHSS, and SSI.
        </p>
        <div class="hero-actions">
          <a class="btn on-dark" href={heroHref} data-wp-event="app_signup_click" data-wp-props={heroProps}>
            Start free →
          </a>
          <a class="btn ghost-dark" href="#iep-check">Check an IEP goal, free</a>
        </div>
        <p class="cta-note">Free to start · no credit card · no email to use the free tools</p>
      </div>
      <PhoneFrame label="Sample Waypoint Home screen: a heads-up that the school's assessment plan is due in 3 days, a box to ask a question, and an IHSS application that is past due on the family's own plan.">
        <div class="ms-card ms-hero">
          <span class="ms-pill ms-soon">HEADS-UP · DUE IN 3 DAYS</span>
          <div class="ms-title">The school's assessment plan is due in 3 days</div>
          <div class="ms-muted">You asked for an evaluation in writing on Oct 1. The district has 15 calendar days to send a plan. Nothing has come in yet.</div>
          <div class="ms-btn">See what to do if it doesn't come</div>
          <div class="ms-muted" style="margin-top:7px">Not today, show the next thing</div>
        </div>
        <div style="font-weight:700;font-size:13px;margin-top:4px">Got something on your mind?</div>
        <div class="ms-ask">
          <div class="ms-field">Ask or search: "they said no" <b>Ask</b></div>
          <div class="ms-chips"><span>They said no</span><span>Read my IEP</span><span>Respite</span><span>Sibling support</span></div>
        </div>
        <div class="ms-card">
          <span class="ms-pill ms-late">PAST DUE · 6 DAYS</span>
          <div class="ms-title" style="font-size:12.5px">Apply for IHSS</div>
          <div class="ms-muted">On your plan · 2 of 8 steps done</div>
        </div>
      </PhoneFrame>
    </div>
  </div>

  <div class="trustband">
    <div class="container band-inner">
      <span><i>✓</i>Free guides and tools, no email required</span>
      <span><i>✓</i>Every claim cited to statute, or it's cut</span>
      <span><i>✓</i>En español</span>
    </div>
  </div>

  <div class="section on-white" id="iep-check">
    <div class="container">
      <span class="eyebrow">Free tool · nothing you paste leaves your browser</span>
      <h2>Is this IEP goal actually measurable?</h2>
      <p class="sub">
        Paste one annual goal from your child's IEP. You'll see which of the five parts of a
        measurable goal it names, and a friendly way to ask the team for any that are missing.
        <a href="/tools/iep-goal-check/">More about the goal check →</a>
      </p>
      <GoalCheck slug="home" cta="tool-result" idPrefix="home-gc" />
    </div>
  </div>

  <div class="section" id="see-it-work">
    <div class="container">
      <span class="eyebrow">See it work</span>
      <h2>What Waypoint does once you're in</h2>
      <p class="sub">Sample screens with a made-up family. Pick a feature to see it.</p>
      <AppShowcase />
      <div class="showcase-cta">
        <a class="btn" href={showcaseHref} data-wp-event="app_signup_click" data-wp-props={showcaseProps}>Start free →</a>
        <a class="link" href="/pricing/">See what's free and what's in Plus</a>
      </div>
    </div>
  </div>

  <div class="section on-white">
    <div class="container">
      <span class="eyebrow">Reminders that come to you</span>
      <h2>Waypoint speaks first.</h2>
      <p class="sub">
        Most tools wait for you to remember. Waypoint knows which clock your request started, and
        checks in before it runs out.
      </p>
      <ol class="timeline">
        {
          timeline.map((t) => (
            <li class="tstep">
              <span class="when">{t.when}</span>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
              {t.push && (
                <div class="push">
                  <b>Waypoint</b>
                  {t.push}
                </div>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <div class="section">
    <div class="container">
      <span class="eyebrow">Free help, right now</span>
      <h2>Start with where you are today</h2>
      <p class="sub">
        Six pillars cover every system a California family navigates — each in plain language,
        with the deadlines, scripts, and template letters that make the next step obvious.
      </p>
      <div class="grid-3">
        {
          pillars.map((p) => (
            <div class="card">
              <h3>{p.title}</h3>
              <p>{p.body}</p>
              {p.always || has(p.href) ? (
                <a class="link" href={p.href}>
                  {p.label}
                </a>
              ) : (
                <span class="link soon" aria-disabled="true">
                  Publishing soon
                </span>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="section on-white">
    <div class="container narrow">
      <EmpathyCallout label="Built by a parent">
        "I'm Mike, father of two boys in Oakland. When my son needed services, I spent hundreds
        of hours navigating the system. I built Waypoint so no family has to do it alone."
      </EmpathyCallout>
      <HandoffCTA
        heading="Turn “What do I do?” into “Here's what to do next.”"
        body="Tell us about your child · see what they may qualify for · get your step-by-step plan."
        action="Get started free"
        slug="home"
        cta="home-footer"
        note="Free to start · no credit card"
      />
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd())} />
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(165deg, #22303a 0%, #123f39 55%, #0f766e 135%);
    color: #eef6f1;
    padding: 56px 0 64px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 40px;
    align-items: center;
  }
  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .hero .eyebrow {
    color: #9fe8db;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.1rem, 4.8vw, 3.2rem);
    line-height: 1.1;
    color: #ffffff;
    margin: 12px 0 12px;
    text-wrap: balance;
  }
  .hero h1 em {
    font-style: normal;
    color: #a9efe0;
  }
  .hero .lede {
    font-size: 1.1rem;
    color: #d3e7de;
    max-width: 54ch;
    margin: 0 0 24px;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .cta-note {
    font-size: 0.8rem;
    color: #b5d6cc;
    margin: 12px 0 0;
  }
  .trustband {
    background: var(--color-panel);
    border-bottom: 1px solid var(--color-border);
  }
  .band-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 34px;
    padding-block: 13px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-ink-soft);
  }
  .band-inner i {
    color: var(--color-sage-ink);
    font-style: normal;
    margin-right: 6px;
  }
  .showcase-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 22px;
    margin-top: 36px;
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  @media (max-width: 860px) {
    .timeline {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .tstep {
    background: var(--color-panel);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .tstep .when {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-pine);
  }
  .tstep h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.15rem;
    margin: 0;
  }
  .tstep p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.92rem;
  }
  .tstep .push {
    margin-top: 6px;
    background: var(--color-paper);
    border-radius: 10px;
    padding: 8px 10px;
    font-size: 0.82rem;
  }
  .tstep .push b {
    display: block;
    font-size: 0.72rem;
    color: var(--color-ink-faint);
  }
</style>
