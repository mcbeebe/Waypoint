---
/**
 * Site search (Pagefind). The index is built by the postbuild step
 * (`pagefind --site dist`), so search works on built deployments, not the
 * dev server — the page says so instead of failing silently. Only elements
 * inside [data-pagefind-body] are indexed (article content, not chrome).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Search Waypoint — every guide, answer, and letter"
  description="Search every Waypoint guide, answer, template letter, and Regional Center page — free, no email, nothing you type is stored."
>
  <PageHero
    eyebrow="Search · free · nothing you type is stored"
    title="Find the answer you need"
    lede="Every guide, answer, template letter, and Regional Center page — searched in your browser. Nothing you type leaves this page."
  />
  <div class="section on-white">
    <div class="container narrow">
      <div id="search"></div>
      <noscript>
        <p>
          Search needs JavaScript. Without it, start from the
          <a href="/guides/">guides library</a> — every page is two clicks from there.
        </p>
      </noscript>
    </div>
  </div>
</BaseLayout>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />

<script>
  // Pagefind UI ships with the built site (same-origin — CSP script-src
  // 'self' allows it). On the dev server the index doesn't exist yet;
  // explain instead of silently showing nothing.
  async function mountSearch() {
    const el = document.getElementById('search');
    if (!el) return;
    try {
      // Built asset, present only after `pagefind --site dist` — resolved in
      // the browser, never by vite or tsc.
      // @ts-expect-error: no module declaration for the build-time asset.
      const mod = await import(/* @vite-ignore */ '/pagefind/pagefind-ui.js');
      const PagefindUI = (mod as { PagefindUI: new (opts: object) => unknown }).PagefindUI;
      new PagefindUI({ element: '#search', showSubResults: true, showImages: false });
      // search_used (D3): first query typed in this pageview.
      let fired = false;
      el.addEventListener('input', (e) => {
        if (fired || !(e.target as HTMLInputElement).value?.trim()) return;
        fired = true;
        window.plausible?.('search_used', { props: { locale: 'en' } });
      });
    } catch {
      el.innerHTML =
        '<p>Search is available on the published site (the index builds at deploy time). ' +
        'Meanwhile, start from the <a href="/guides/">guides library</a>.</p>';
    }
  }
  mountSearch();
</script>
