---
/**
 * Start-here checklists by diagnosis (guides collection, `start/` prefix,
 * keyword rows /start/<diagnosis>/). The emotional page-hero H1 replaces the
 * article H1 treatment; the interactive checklist lives in the MDX body.
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import DraftBanner from '../../components/DraftBanner.astro';
import InlineDisclaimer from '../../components/InlineDisclaimer.astro';
import { visibleEntries } from '../../lib/content';
import { articleJsonLd, breadcrumbsJsonLd } from '../../lib/jsonld';
import type { Crumb } from '../../lib/jsonld';

export async function getStaticPaths() {
  const guides = await visibleEntries('guides');
  return guides
    .filter((entry) => entry.id === 'start' || entry.id.startsWith('start/'))
    .map((entry) => ({
      // `start/index.mdx` is the generic entry point and owns /start/ itself;
      // any other file under start/ becomes a diagnosis-specific spoke.
      params: {
        // 'start' (from start/index.mdx, whose `/index` Astro strips) is the
        // diagnosis-general entry point and owns /start/ itself; anything
        // deeper is a diagnosis-specific spoke.
        slug:
          entry.id === 'start'
            ? undefined
            : entry.id.replace(/^start\//, '').replace(/\.mdx?$/, ''),
      },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const id = entry.id.replace(/\.mdx?$/, '');
const isDraft = d.status !== 'published';

/* This route builds its own hero instead of using ArticleLayout, and that is
   why it shipped with no structured data at all while every other content
   page emitted two blocks — the flagship page was the one Google could read
   least. Same Article + BreadcrumbList payloads ArticleLayout produces. */
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const crumbs: Crumb[] = [{ name: 'Guides', href: '/guides/' }, { name: d.title }];
const jsonLd = !isDraft
  ? articleJsonLd({
      url: pageUrl,
      title: d.title,
      description: d.description,
      locale: d.locale,
      author: d.author,
      datePublished: d.datePublished,
      dateModified: d.dateModified,
      review: d.review ? { reviewedBy: d.review.reviewedBy, credential: d.review.credential } : null,
    })
  : null;
const crumbLd = !isDraft ? breadcrumbsJsonLd(crumbs) : null;
---

<BaseLayout
  title={`${d.seoTitle ?? d.title} — Waypoint`}
  description={d.description}
  locale={d.locale}
  noindex={d.noindex || isDraft}
  pillar={d.pillar}
  ogSlug={Astro.url.pathname}
  ogType="article"
>
  <PageHero eyebrow="Worried, or just diagnosed · California" title={d.title} />
  <div class="section on-white">
    <div class="container narrow">
      {isDraft && <DraftBanner status={d.status} />}
      <div
        id="article-root"
        data-slug={id}
        data-pillar={d.pillar}
        data-locale={d.locale}
        data-pagefind-body
      >
        <Content />
      </div>
      <InlineDisclaimer variant={d.disclaimerVariant} />
    </div>
  </div>
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  {crumbLd && <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />}
</BaseLayout>

<script>
  // Checklist interactivity: accessible checkbox semantics, progress bar,
  // the two-items cheer, and the checklist deep-link ctx (D3: checked item
  // ids ride wp_ctx so the app can pre-check them in the saved plan).
  const items = Array.from(document.querySelectorAll<HTMLElement>('.check-item'));
  if (items.length) {
    const fill = document.getElementById('start-progress-fill');
    const label = document.getElementById('start-progress-label');
    const cheer = document.getElementById('start-cheer');
    const cta = document.querySelector<HTMLAnchorElement>('[data-checklist-cta]');
    const slug = document.getElementById('article-root')?.dataset.slug ?? '';

    const checkedIds = () =>
      items.filter((i) => i.classList.contains('done')).map((i) => i.dataset.itemId ?? '');

    const update = () => {
      const done = checkedIds().length;
      if (fill) fill.style.width = `${Math.round((done / items.length) * 100)}%`;
      if (label) label.textContent = `${done} of ${items.length} started`;
      if (cheer) cheer.hidden = done < 2;
      if (cta) {
        // Rebuild wp_ctx on the checklist CTA so checked items carry over.
        const url = new URL(cta.href);
        const ctx = { v: 1, kind: 'checklist', slug, checked: checkedIds() };
        const b64 = btoa(JSON.stringify(ctx))
          .replace(/\+/g, '-')
          .replace(/\//g, '_')
          .replace(/=+$/, '');
        url.searchParams.set('wp_ctx', b64);
        cta.href = url.toString();
      }
    };

    items.forEach((it, idx) => {
      if (!it.dataset.itemId) it.dataset.itemId = `item-${idx + 1}`;
      // The checkbox semantics live on the real <button role="checkbox">
      // inside the card (CheckItem.astro); the card itself is a click
      // convenience only, so links inside step text keep their semantics.
      const box = it.querySelector<HTMLButtonElement>('[data-check-toggle]');
      if (!box) return;
      const toggle = () => {
        it.classList.toggle('done');
        const on = it.classList.contains('done');
        box.setAttribute('aria-checked', String(on));
        box.textContent = on ? '✓' : '';
        update();
      };
      box.addEventListener('click', (e) => {
        e.stopPropagation();
        toggle();
      });
      it.addEventListener('click', (e) => {
        // Links inside a step should navigate, not toggle the step.
        if ((e.target as Element).closest('a, button')) return;
        toggle();
      });
    });
    update();
  }
</script>
