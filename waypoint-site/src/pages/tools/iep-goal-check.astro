---
/**
 * IEP goal check — initiative 013, option A (owner decision 2026-10-08):
 * a rule-based check of ONE annual goal that runs only in the browser. It
 * reads whether a goal names the five parts of a measurable goal; it never
 * judges whether the goal is right for the child. The full AI IEP analysis
 * stays a Premium app feature and is offered as the next step.
 *
 * PENDING REVIEW: noindex here and filtered from the sitemap in
 * astro.config.mjs until the owner signs off the page copy — the same
 * pattern /accessibility/ uses. Lift both together.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import AnswerFirst from '../../components/AnswerFirst.astro';
import Cite from '../../components/Cite.astro';
import NoticeBox from '../../components/NoticeBox.astro';
import InlineDisclaimer from '../../components/InlineDisclaimer.astro';
import Sources from '../../components/Sources.astro';
import GoalCheck from '../../components/GoalCheck.astro';
import { sourceAnchorId, type SourceEntry } from '../../lib/citations';

// Same verified entry the IEP guide carries (src/content/guides/iep.mdx).
const sources: SourceEntry[] = [
  {
    label: 'CA Ed Code §56345 (required contents of an IEP)',
    url: 'https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=EDC&sectionNum=56345.',
    accessed: '2026-09-08',
  },
  // Same verified entry the dispute-ladder guide carries.
  {
    label: 'Ed Code §56343.5 (parent-requested IEP team meeting held within 30 days of the written request)',
    url: 'https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=EDC&sectionNum=56343.5.',
    accessed: '2026-09-08',
  },
];
const citeHref = `#${sourceAnchorId('Ed Code §56345')}`;
const meetingHref = `#${sourceAnchorId('Ed Code §56343.5')}`;

const parts = [
  ['A timeframe', 'When it should be met — "By May 2027" or "within one year".'],
  ['The conditions', 'The situation it is measured in — "when given a grade-level passage", "with a visual schedule".'],
  ['An observable skill', 'Something a teacher can see or count — "will write", "will ask for a break" — rather than "will improve" or "will understand".'],
  ['How well — a number', 'The target — "4 of 5", "80% accuracy", "for 10 minutes".'],
  ['How it will be measured', 'Who tracks it and how — "teacher-charted data", "work samples", "observation".'],
];
---

<BaseLayout
  title="Free IEP goal check — is this goal measurable? — Waypoint"
  description="Paste one goal from your child's IEP and see whether it names a timeframe, conditions, an observable skill, a target, and how it's measured. Free, private, nothing uploaded."
  pillar="iep"
  noindex={true}
>
  <PageHero
    eyebrow="Free tool · no email · nothing you paste leaves your browser"
    title="Is this IEP goal actually measurable?"
    lede="Paste one annual goal from your child's IEP. You'll see which of the five parts of a measurable goal it names, and a friendly way to ask the team for any that are missing."
  />
  <div class="section">
    <div class="container">
      <GoalCheck slug="tools/iep-goal-check" cta="tool-result" />
      <NoticeBox>
        This checks the wording of one goal against a simple pattern. It can miss a part that is
        phrased unusually, and it can't tell whether a goal is the right goal for your child. Use
        it to know what to ask, not as a verdict on the IEP.
      </NoticeBox>

      <article class="prose" style="margin-top:34px">
        <h2 class="qa-h">What makes an IEP goal measurable</h2>
        <AnswerFirst>
          California law requires every IEP to include <b>measurable annual goals</b>, academic
          and functional, along with how progress toward them will be measured and when it will
          be reported to you. <Cite href={citeHref}>Ed Code §56345</Cite> A goal everyone can
          measure the same way usually names five things:
        </AnswerFirst>
        <ol>
          {parts.map(([name, body]) => (
            <li><strong>{name}.</strong> {body}</li>
          ))}
        </ol>
        <p>
          A goal like "will improve reading skills" leaves the team without a shared way to tell
          whether it was met. You can ask for the missing parts at any IEP meeting, and you can
          ask for a meeting in writing at any time; the district holds it within 30 days of your
          request. <Cite href={meetingHref}>Ed Code §56343.5</Cite> Our{' '}
          <a href="/guides/iep/">IEP guide</a> walks through what to bring and what to sign.
        </p>
        <InlineDisclaimer variant="legal" />
        <Sources sources={sources} />
      </article>
    </div>
  </div>
</BaseLayout>
