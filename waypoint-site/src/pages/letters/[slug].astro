---
/** Template-letter pages (letters collection) — narrow article layout. */
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { visibleEntries } from '../../lib/content';

export async function getStaticPaths() {
  const letters = await visibleEntries('letters');
  return letters.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const id = entry.id.replace(/\.mdx?$/, '');
---

<ArticleLayout
  title={d.seoTitle ?? d.title}
  description={d.description}
  heading={d.title}
  crumbs={[{ name: 'Guides', href: '/guides/' }, { name: 'Letters' }, { name: d.title.split(':')[0] }]}
  locale={d.locale}
  status={d.status}
  author={d.author}
  review={d.review}
  datePublished={d.datePublished}
  dateModified={d.dateModified}
  disclaimerVariant={d.disclaimerVariant}
  noindex={d.noindex}
  slug={`letters/${id}`}
  pillar={d.pillar}
  narrow
>
  <Content />
</ArticleLayout>
