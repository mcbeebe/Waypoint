---
/**
 * Pricing. ONE paid tier, Premium: $9.99/month or $99/year, first 30 days free
 * (owner decision 2026-10-08: "one price tier right now bc the offerings
 * aren't split"). This supersedes D13 (2026-09-06: Plus $4.99 / Pro $9.99,
 * 3-month trial), which the app never implemented: the app has always had a
 * single Premium tier (waypoint-app/src/lib/entitlements.ts).
 *
 * The figures must move in lockstep with the app's PRICE_* constants and the
 * Stripe Payment Links: src/lib/pricingSync.test.ts (vitest, run by the site
 * CI job, which also triggers on entitlements.ts) fails if this page shows a
 * price, trial or Premium feature the app doesn't define. The Premium list is
 * exactly the app's PREMIUM_FEATURES — what the paywall actually gates. The competitor comparison stays
 * drafts-only until its details are verified (launch checklist row 25).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import AnswerFirst from '../components/AnswerFirst.astro';
import NoticeBox from '../components/NoticeBox.astro';
import HandoffCTA from '../components/HandoffCTA.astro';
import InlineDisclaimer from '../components/InlineDisclaimer.astro';
import PageHero from '../components/PageHero.astro';
import { appStartUrl } from '../lib/appLinks';
import { showDrafts } from '../lib/content';

const planLink = (plan: string) => ({
  href: appStartUrl({ slug: 'pricing', cta: 'pricing-card', ctx: { v: 1, kind: 'guide', slug: 'pricing', next_action: `plan-${plan}` } }),
  props: JSON.stringify({ slug: 'pricing', locale: 'en', cta_id: 'pricing-card' }),
});
const free = planLink('free');
const premium = planLink('premium');
---

<BaseLayout
  title="Waypoint pricing — free to start, honest when you need more"
  description="Every Waypoint guide, tool, and letter is free forever. The app is free to start; Premium is $9.99/month or $99/year, and the first 30 days are free."
>
  <PageHero
    eyebrow="Pricing"
    title="Free to start. Honest when you need more."
    lede="Everything on this site — every guide, tool, and letter — stays free forever. The app is where Waypoint goes from telling you what to do to doing it with you: tracking deadlines, drafting letters, keeping the plan. Most of that is free too. Premium adds the rest — and its first 30 days are free."
  />

  <div class="section">
    <div class="container">
      <div class="price-grid">
        <div class="price-card">
          <span class="plan">FREE</span>
          <div class="amount">$0</div>
          <ul>
            <li>30 AI Navigator messages a month</li>
            <li>Eligibility results with sources</li>
            <li>Request tracker with the legal clocks</li>
            <li>Starter action plan and deadlines</li>
            <li>Core letters, drafted for you</li>
            <li>Expense tracking and your document binder</li>
            <li>No credit card</li>
          </ul>
          <a class="btn" href={free.href} data-wp-event="app_signup_click" data-wp-props={free.props}>Start free</a>
        </div>
        <div class="price-card featured">
          <span class="plan">PREMIUM</span>
          <div class="amount">$9.99<small>/mo</small></div>
          <ul>
            <li><b>First 30 days free</b></li>
            <li>Or $99 billed yearly (save over $20)</li>
            <li>Everything in Free, plus:</li>
            <li>Unlimited AI Navigator</li>
            <li>IEP document analysis and goal tracking</li>
            <li>Tax reports from your expenses</li>
            <li>Paper-trail export</li>
            <li>Document sharing links</li>
            <li>Multi-child support</li>
          </ul>
          <a class="btn" href={premium.href} data-wp-event="app_signup_click" data-wp-props={premium.props}>Start with Premium →</a>
        </div>
      </div>
      <p class="trial-note">
        Premium's first 30 days are free on either plan. After that it renews at $9.99 a month or
        $99 a year until you cancel. Cancel before day 30 and you pay nothing — and the free tier
        stays free either way.
      </p>
    </div>
  </div>

  {/*
    Owner decision, 2026-09-08: the paid app is free for families whose child
    receives SSI and for anyone who says they can't afford it — no documents,
    ever. Stated here, on the pricing page, rather than buried in an FAQ: a
    family deciding whether they can afford this decides on this page, and a
    policy they never find is not a policy. Deliberately price-independent
    copy, so it stays true when the tier figures move.
  */}
  <div class="section on-cream">
    <div class="container narrow">
      <span class="eyebrow">If money is tight</span>
      <h2>Then it's free — for as long as you need it.</h2>
      <article class="prose">
        <p>
          If your child receives <b>SSI</b>, the paid features are already on when you sign in.
          You won't see a price, and you don't have to ask.
        </p>
        <p>
          If money is tight for any other reason, just say so inside the app and we'll turn
          everything on. <b>No form, no proof, no follow-up questions.</b>
        </p>
        <p>
          It's funded by the families who do pay. If you need it, take it — that's what it's
          for.
        </p>
      </article>
    </div>
  </div>

  <div class="section">
    <div class="container narrow">
    </div>
  </div>

  {showDrafts && (
  <div class="section on-white">
    <div class="container narrow">
      <span class="eyebrow">Comparison</span>
      <h2>How we compare</h2>
      <p class="sub">
        You deserve a straight answer on where your money goes. Here is Waypoint Premium next to
        the closest alternative.
      </p>
      <div class="table-wrap">
        <table class="data">
          <tr><th><span class="sr-only">Feature</span></th><th>Waypoint Premium</th><th>Undivided membership</th></tr>
          <tr><td>Price</td><td><b>$9.99/mo</b> ($99/yr) · first 30 days free</td><td>$19/mo ($149/yr)</td></tr>
          <tr><td>AI access</td><td><b>24/7 — including on the free tier</b></td><td>Behind the paywall</td></tr>
          <tr><td>Free content gates</td><td><b>Zero</b> — every guide and letter is open</td><td>Lead magnets require name, email, phone</td></tr>
          <tr><td>Human navigators</td><td>No — software plus your real-life team</td><td>Yes — 2 navigator video sessions</td></tr>
          <tr><td>Languages</td><td><b>Letters in English, Spanish, and Vietnamese</b></td><td>3 Spanish PDFs</td></tr>
        </table>
      </div>
      <NoticeBox>
        Competitor details as observed Sept 5, 2026 — verify before publishing (this section
        renders on preview builds only until then; launch checklist row 25).
      </NoticeBox>

      <h2 class="qa-h">Why is Waypoint so much cheaper?</h2>
      <AnswerFirst>
        Because Waypoint is a <b>software platform, not a consulting firm</b>. Human navigators
        are wonderful — and expensive, and available by appointment. We put the money into an AI
        that knows the Lanterman Act, IDEA, Medi-Cal, and SSI, answers at 2 a.m., and drafts your
        letters in English, Spanish, or Vietnamese. <b>Other platforms tell you what to do. We do it.</b>
      </AnswerFirst>
      <p>
        That economic choice is also a philosophical one. When guidance depends on scheduling a
        human, it gets rationed. When it's software, it can be unlimited, instant, and cheap
        enough that no family has to choose between answers and groceries. And the parts a human
        truly should do — sitting across the IEP table, knowing your child — belong to you and
        your real-life team, not to a subscription.
      </p>
    </div>
  </div>
  )}

  <div class="section">
    <div class="container narrow">
      <HandoffCTA
        heading="Start free. Upgrade only if it earns it."
        body="Ask your first questions, run the eligibility tools, and see the plan Waypoint builds — and if you want Premium, its first 30 days are free."
        action="Create your free account →"
        slug="pricing"
        cta="pricing-card"
        ctx={{ v: 1, kind: 'guide', slug: 'pricing', next_action: 'pricing-footer' }}
      />
      <InlineDisclaimer variant="legal" />
    </div>
  </div>
</BaseLayout>

<style>
  /* One paid tier: two cards, centred, instead of the global three-up grid. */
  .price-grid {
    grid-template-columns: repeat(2, 1fr);
    max-width: 760px;
    margin: 0 auto;
  }
  @media (max-width: 800px) {
    .price-grid {
      grid-template-columns: 1fr;
    }
  }
  .trial-note {
    font-size: 0.88rem;
    color: var(--color-ink-soft);
    max-width: 66ch;
    margin: 18px auto 0;
    text-align: center;
  }
</style>
