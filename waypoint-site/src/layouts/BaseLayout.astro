---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description: string;
  locale?: 'en' | 'es';
  noindex?: boolean;
  /** Pillar of the current page — required on pillar content so the header
   * CTA can carry wp_pillar (D3: required on pillar content). */
  pillar?: string;
  /** Content URL, so Seo can pick this page's build-time OG card. */
  ogSlug?: string;
  ogType?: 'website' | 'article';
}
const { title, description, locale = 'en', noindex = false, pillar, ogSlug, ogType } = Astro.props;
const isProd = (process.env.VERCEL_ENV ?? 'production') === 'production';
// GA4: second, additional tracker alongside Plausible (D3 "Providers"). The
// Measurement ID is committed, not a secret — gtag.js publishes it in the
// markup of every page. GA_MEASUREMENT_ID overrides it for a separate
// property. Preview/dev never reach it: isProd gates the tag, not this value.
const gaMeasurementId = process.env.GA_MEASUREMENT_ID ?? 'G-VEB7T9ZVH5';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/hanken-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/newsreader-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <Seo title={title} description={description} noindex={noindex} ogSlug={ogSlug} ogType={ogType} />
    {/* Plausible: cookieless analytics — events per docs/analytics-taxonomy.md
        (D3). Loaded only on production deploys so preview/branch QA traffic
        never pollutes the production data-domain (local non-Vercel builds
        keep it for testing; those pages aren't visited by anyone). */}
    {
      isProd && (
        <>
          {/* External, not inline: the CSP blocks inline scripts. The init file
              also mirrors every event to GA4. See public/plausible-init.js. */}
          <script is:inline src="/plausible-init.js" />
          <script async src="https://plausible.io/js/pa-oWUSFlebFmKz0lRdhJ6_x.js" />
        </>
      )
    }
    {/* GA4: second, additional tracker per D3 "Providers" — loads only when
        GA_MEASUREMENT_ID is configured, same production-only gate as Plausible.
        Google Signals / ad personalization stay off (privacy posture). */}
    {
      isProd && gaMeasurementId && (
        <>
          {/* External, not inline: the CSP blocks inline scripts. See public/ga-init.js. */}
          <script is:inline src="/ga-init.js" data-ga-id={gaMeasurementId} />
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} />
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader pillar={pillar} locale={locale} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    {/* Vercel Web Analytics: page views only, for the hosting dashboard
        (D3 "Providers"). No event goes through it — every window.plausible
        call still fans out to Plausible + the GA4 mirror. The component's
        script stays an external file because astro.config sets
        assetsInlineLimit: 0 (Astro would otherwise inline a chunk this small,
        and the CSP — script-src 'self', no 'unsafe-inline' — would kill it);
        it then loads same-origin /_vercel/insights/script.js, which Vercel
        serves only while Web Analytics is switched ON for the project in the
        dashboard — enable first, then deploy, or every page 404s it. Not
        gated to production: Vercel tags each view with its environment, so
        preview QA is filterable rather than pollution. Built locally the
        script 404s harmlessly; `astro dev` loads Vercel's no-op debug script
        instead. */}
    <Analytics />
    <script>
      // window.plausible (queue + GA4 mirror) is defined in public/plausible-init.js,
      // production only; every call here stays optional-chained for preview/dev.

      // Delegated analytics per docs/analytics-taxonomy.md (D3).
      // app_signup_click: any element carrying data-wp-event fires its event
      // with the JSON props in data-wp-props (Plausible uses keepalive
      // requests, so the event survives the navigation).
      document.addEventListener('click', (e) => {
        const el = (e.target as Element | null)?.closest<HTMLElement>('[data-wp-event]');
        if (!el?.dataset.wpEvent) return;
        let props: Record<string, string | number> = {};
        try {
          props = JSON.parse(el.dataset.wpProps ?? '{}');
        } catch {
          /* malformed props: still record the event itself */
        }
        window.plausible?.(el.dataset.wpEvent, { props });
      });

      // js_error beacon (page + hashed message — never message text, which
      // could contain URLs or user input).
      const hash = (s: string) => {
        let h = 5381;
        for (let i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) | 0;
        return (h >>> 0).toString(36);
      };
      const beacon = (message: string) =>
        window.plausible?.('js_error', {
          props: { page: location.pathname, message_hash: hash(message) },
        });
      window.addEventListener('error', (e) => beacon(String(e.message ?? 'error')));
      window.addEventListener('unhandledrejection', (e) =>
        beacon(String((e as PromiseRejectionEvent).reason ?? 'rejection')),
      );
    </script>
  </body>
</html>
