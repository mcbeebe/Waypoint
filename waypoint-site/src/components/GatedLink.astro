---
/**
 * Prose link that gates on the publish state of its target, like the header
 * and hubs do: if the target URL exists in this build, render a normal link;
 * if it's still in review (draft-gated out of production), render the text
 * with an honest "coming soon" tag instead of a dead link. Published pages
 * may therefore reference unpublished spokes freely — the link appears by
 * itself the moment the spoke publishes, with no edit to the citing page.
 */
import { visibleContentUrls } from '../lib/content';

interface Props {
  href: string;
  class?: string;
}
const { href, class: cls } = Astro.props;
const live = (await visibleContentUrls()).has(href);
---

{
  live ? (
    <a class={cls} href={href}>
      <slot />
    </a>
  ) : (
    <span class="gated-soon">
      <slot />
      <span class="tag">(in review — coming soon)</span>
    </span>
  )
}

<style>
  .gated-soon {
    color: var(--color-ink-faint);
  }
  .gated-soon .tag {
    font-size: 0.85em;
    white-space: nowrap;
  }
</style>
