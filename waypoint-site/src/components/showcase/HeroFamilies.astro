---
/**
 * Hero card: "Same Monday, four different families" (initiative 013; the
 * four families approved by the owner 2026-10-08). Each tab shows that
 * family's Home heads-up. Families and names are fictional.
 *
 * Every clock shown is one the site already cites: Ed Code §56321 (15
 * calendar days, assessment plan) and 17 CCR §52086 (Early Start 45 days).
 * Status-first wording per the CLAUDE.md tone rule — nobody "missed" anything.
 *
 * The tab row renders server-side (revealing it from script shifted the
 * layout: CLS 0.25 in the perf budget). Without JS the first family shows.
 */
import PhoneFrame from './PhoneFrame.astro';
import '../../styles/showcase.css';

const families = [
  {
    id: 'early',
    tab: 'Just diagnosed',
    label:
      "Sample Home screen for Leo, age 2: the Regional Center's first family service plan meeting is due within 45 days of referral, with the next step to get ready.",
    pill: 'COMING UP · DAY 31 OF 45',
    pillKind: 'ms-soon',
    title: "Leo's Early Start plan meeting is coming up",
    body: 'The Regional Center has 45 days from your referral to evaluate Leo and hold the first family service plan meeting.',
    button: 'Get ready for the meeting',
    next: 'Write down what you see at home',
    nextMeta: 'On your plan · 1 of 4 steps done',
  },
  {
    id: 'iep',
    tab: 'IEP years',
    label:
      "Sample Home screen for Maya, age 8: the school's assessment plan is due in 3 days, 15 calendar days after the written request.",
    pill: 'HEADS-UP · DUE IN 3 DAYS',
    pillKind: 'ms-soon',
    title: "The school's assessment plan is due in 3 days",
    body: 'You asked for an evaluation in writing on Oct 1. The district has 15 calendar days to send a plan. Nothing has come in yet.',
    button: "See what to do if it doesn't come",
    next: 'Ask for typing as a writing accommodation',
    nextMeta: 'On your plan · School',
  },
  {
    id: 'benefits',
    tab: 'Benefits',
    label:
      "Sample Home screen for Ana, age 6: the county's IHSS home visit is Thursday, with a checklist of what to have ready.",
    pill: 'THIS WEEK · THURSDAY',
    pillKind: 'ms-soon',
    title: 'The IHSS home visit is Thursday',
    body: "A county social worker will ask how much care Ana needs each day. Here's what to have ready.",
    button: 'Open the visit checklist',
    next: 'Ask about Medi-Cal institutional deeming',
    nextMeta: 'On your plan · 2 of 8 steps done',
  },
  {
    id: 'adult',
    tab: 'Turning 18',
    label:
      'Sample Home screen for Sam, age 17: Sam turns 18 in 5 months, and some adult steps take months to arrange, so the plan starts them now.',
    pill: 'PLAN AHEAD · 5 MONTHS',
    pillKind: 'ms-soon',
    title: 'Sam turns 18 in 5 months',
    body: 'Some adult steps take months to arrange, so families start well before the birthday. Here are the three to begin now.',
    button: 'See the three steps',
    next: 'Talk about decision-making support',
    nextMeta: 'On your plan · Turning 18',
  },
];
---

<div class="families" data-families>
  <div class="fam-tabs" role="group" aria-label="Sample families" data-tablist>
    {
      families.map((f, i) => (
        <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-fam={f.id} data-label={f.label}>
          {f.tab}
        </button>
      ))
    }
  </div>
  <PhoneFrame label={families[0].label}>
    {
      families.map((f, i) => (
        <div data-panel={f.id} hidden={i !== 0} class="fam-panel">
          <div class="ms-card ms-hero">
            <span class={`ms-pill ${f.pillKind}`}>{f.pill}</span>
            <div class="ms-title">{f.title}</div>
            <div class="ms-muted">{f.body}</div>
            <div class="ms-btn">{f.button}</div>
            <div class="ms-muted fam-later">Not today, show the next thing</div>
          </div>
          <div class="ms-card fam-next">
            <div class="ms-title">{f.next}</div>
            <div class="ms-muted">{f.nextMeta}</div>
          </div>
        </div>
      ))
    }
    <div class="fam-ask-label">Got something on your mind?</div>
    <div class="ms-ask">
      <div class="ms-field">Ask or search: "they said no" <b>Ask</b></div>
      <div class="ms-chips"><span>They said no</span><span>Read my IEP</span><span>Respite</span></div>
    </div>
  </PhoneFrame>
</div>

<script>
  // Toggle buttons, not tabs: the cards live inside the phone, which is one
  // labelled image to assistive tech, so choosing a family swaps the cards AND
  // the phone's spoken description. Every button stays in the Tab order.
  document.querySelectorAll<HTMLElement>('[data-families]').forEach((root) => {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-fam]'));
    const phone = root.querySelector<HTMLElement>('[role="img"]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        for (const b of buttons) {
          const on = b === btn;
          b.setAttribute('aria-pressed', String(on));
          const panel = root.querySelector<HTMLElement>(`[data-panel="${b.dataset.fam}"]`);
          if (panel) panel.hidden = !on;
        }
        if (phone && btn.dataset.label) phone.setAttribute('aria-label', btn.dataset.label);
      });
    });
  });
</script>

