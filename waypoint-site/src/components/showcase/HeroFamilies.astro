---
/**
 * Hero card: "Same Monday, four different families" (initiative 013; the
 * four families approved by the owner 2026-10-08). Each button shows that
 * family's Home card. Families and names are fictional. "Today" is Monday,
 * Oct 12, 2026 for all four, and every date below is computed from it.
 *
 * Every card is one the app's Home triage can actually produce, worded the
 * way `waypoint-app/src/lib/homeTriage.ts` words it: a request clock
 * (`clockItems`: rc_assessment W&I §4643, iep_evaluation Ed Code §56321), a
 * date the family added (`deadlineItems`), or a plan step due today
 * (`actionItems`). Status-first per the CLAUDE.md tone rule.
 *
 * The button row renders server-side (revealing it from script shifted the
 * layout: CLS 0.25 in the perf budget). Without JS the first family shows.
 */
import PhoneFrame from './PhoneFrame.astro';
import '../../styles/showcase.css';

const families = [
  {
    id: 'early',
    tab: 'Just diagnosed',
    label:
      "Sample Home screen for Leo, age 3: the Regional Center's answer on his assessment is due in 9 days, with a follow-up one tap away.",
    pill: 'CLOCK RUNNING — 9 DAYS LEFT',
    title: "An answer on Leo's Regional Center assessment is due Oct 21",
    body: 'Because you asked on Jun 23 and the law gives them a fixed window.',
    cite: 'W&I §4643',
    button: 'Draft the follow-up',
    next: 'Write down what you see at home',
    nextMeta: 'On your plan · 1 of 4 steps done',
  },
  {
    id: 'iep',
    tab: 'IEP years',
    label:
      "Sample Home screen for Maya, age 8: the school's answer on her evaluation request is due in 4 days, with a follow-up one tap away.",
    pill: 'CLOCK RUNNING — 4 DAYS LEFT',
    title: "An answer on Maya's evaluation request is due Oct 16",
    body: 'Because you asked on Oct 1 and the law gives them a fixed window.',
    cite: 'Ed Code §56321',
    button: 'Draft the follow-up',
    next: 'Ask for typing as a writing accommodation',
    nextMeta: 'On your plan · School',
  },
  {
    id: 'benefits',
    tab: 'Benefits',
    label:
      "Sample Home screen for Ana, age 6: the IHSS home visit her family added is coming up in 3 days.",
    pill: 'COMING UP — 3 DAYS',
    title: 'IHSS home visit',
    body: 'Because you have this dated Thu, Oct 15 in Waypoint.',
    cite: '',
    button: 'Open the calendar',
    next: 'Ask about Medi-Cal institutional deeming',
    nextMeta: 'On your plan · 2 of 8 steps done',
  },
  {
    id: 'adult',
    tab: 'Turning 18',
    label:
      "Sample Home screen for Sam, age 17: a step on the family's plan, learning the decision-making options at 18, is due today.",
    pill: 'DUE TODAY',
    title: 'Learn the decision-making options at 18',
    body: "Because it's due today and it's on your plan.",
    cite: '',
    button: 'Open this action',
    next: 'Ask about SSI at 18',
    nextMeta: 'On your plan · Turning 18',
  },
];
---

<div class="families" data-families>
  <div class="fam-tabs" role="group" aria-label="Sample families" data-tablist>
    {
      families.map((f, i) => (
        <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-fam={f.id} data-label={f.label}>
          {f.tab}
        </button>
      ))
    }
  </div>
  <p class="ms-sr" aria-live="polite" data-fam-status></p>
  <PhoneFrame label={families[0].label}>
    {
      families.map((f, i) => (
        <div data-panel={f.id} hidden={i !== 0} class="fam-panel">
          <div class="ms-card ms-hero">
            <span class="ms-pill ms-soon">{f.pill}</span>
            <div class="ms-title">{f.title}</div>
            <div class="ms-muted">{f.body}{f.cite && <b class="fam-law"> {f.cite}</b>}</div>
            <div class="ms-btn">{f.button}</div>
            <div class="ms-muted fam-later">Not today — show the next thing</div>
          </div>
          <div class="ms-card fam-next">
            <div class="ms-title">{f.next}</div>
            <div class="ms-muted">{f.nextMeta}</div>
          </div>
        </div>
      ))
    }
    <div class="fam-ask-label">Got something on your mind?</div>
    <div class="ms-ask">
      <div class="ms-field">Ask or search: "they said no" <b>Ask</b></div>
      <div class="ms-chips"><span>They said no</span><span>Read my IEP</span><span>Respite</span></div>
    </div>
  </PhoneFrame>
</div>

<script>
  // Toggle buttons, not tabs: the cards live inside the phone, which is one
  // labelled image to assistive tech, so choosing a family swaps the cards AND
  // the phone's spoken description. Every button stays in the Tab order.
  document.querySelectorAll<HTMLElement>('[data-families]').forEach((root) => {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-fam]'));
    const phone = root.querySelector<HTMLElement>('[role="img"]');
    const status = root.querySelector<HTMLElement>('[data-fam-status]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        for (const b of buttons) {
          const on = b === btn;
          b.setAttribute('aria-pressed', String(on));
          const panel = root.querySelector<HTMLElement>(`[data-panel="${b.dataset.fam}"]`);
          if (panel) panel.hidden = !on;
        }
        if (phone && btn.dataset.label) phone.setAttribute('aria-label', btn.dataset.label);
        // A changed aria-label is not announced; the live line is.
        if (status && btn.dataset.label) status.textContent = btn.dataset.label;
      });
    });
  });
</script>

