---
/**
 * A code-built phone showing an app screen on the marketing site
 * (initiative 013). The screens inside are illustrations with a fictional
 * family, never a real one, so the frame is one labelled image to assistive
 * tech: `label` says what the screen shows, and the mock text inside is not
 * read out as if it were the reader's own data.
 */
interface Props {
  /** What the screen shows, read by screen readers in place of the mock UI. */
  label: string;
  /** Title in the app bar; omit for a screen without one. */
  appBar?: string;
  /** Which bottom tab is active. */
  tab?: 'Home' | 'Journey' | 'Learn' | 'Tools' | 'Plan';
}
const { label, appBar, tab = 'Home' } = Astro.props;
const tabs = ['Home', 'Journey', 'Learn', 'Tools', 'Plan'] as const;
---

<div class="phone" role="img" aria-label={label}>
  <div class="phone-screen" aria-hidden="true">
    <div class="phone-status">app.waypointchild.com</div>
    {appBar && <div class="phone-appbar">{appBar}</div>}
    <div class="phone-body"><slot /></div>
    <div class="phone-tabs">
      {tabs.map((t) => <span class={t === tab ? 'on' : undefined}>{t}</span>)}
    </div>
  </div>
</div>

<style>
  .phone {
    width: 300px;
    max-width: 100%;
    margin: 0 auto;
    background: #141a1f;
    border-radius: 36px;
    padding: 10px;
    box-shadow: 0 24px 50px rgba(18, 38, 36, 0.28);
  }
  .phone-screen {
    background: var(--color-paper);
    border-radius: 28px;
    overflow: hidden;
    height: 560px;
    display: flex;
    flex-direction: column;
    font-size: 12px;
    line-height: 1.45;
    color: var(--color-ink);
  }
  .phone-status {
    height: 26px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 10px;
    color: var(--color-ink-soft);
    flex: none;
  }
  .phone-appbar {
    background: var(--color-cream);
    padding: 9px 12px;
    font-weight: 700;
    font-size: 13px;
    border-bottom: 1px solid var(--color-border);
    flex: none;
  }
  .phone-body {
    flex: 1;
    overflow: hidden;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .phone-tabs {
    display: flex;
    justify-content: space-around;
    border-top: 1px solid var(--color-border);
    background: var(--color-panel);
    padding: 7px 0 10px;
    font-size: 9.5px;
    color: var(--color-ink-soft);
    flex: none;
  }
  .phone-tabs .on {
    color: var(--color-pine);
    font-weight: 700;
  }
</style>
