---
/**
 * The conversion primitive — the ONLY way a page hands off into the app.
 * Builds the deep link per docs/analytics-taxonomy.md (D3) and fires
 * app_signup_click via the delegated listener in BaseLayout.
 */
import { appStartUrl, type CtaId, type Pillar, type WpCtx } from '../lib/appLinks';

interface Props {
  heading: string;
  body: string;
  action: string;
  slug: string;
  cta: CtaId;
  pillar?: Pillar;
  locale?: 'en' | 'es';
  ctx?: WpCtx;
  /** Marks the link so the checklist script can refresh its wp_ctx. */
  checklist?: boolean;
  /** Short friction-reducer under the button ("Free to start · no credit
   * card") — conversion best practice is putting this next to the ask, not
   * only in a trustband elsewhere on the page. Optional: most of this
   * component's 40+ callers don't need it: it exists for the homepage's
   * primary conversion CTAs. */
  note?: string;
}
const {
  heading,
  body,
  action,
  slug,
  cta,
  pillar,
  locale = 'en',
  ctx,
  checklist = false,
  note,
} = Astro.props;
const href = appStartUrl({ slug, cta, pillar, locale, ctx });
const props = JSON.stringify({
  slug,
  ...(pillar ? { pillar } : {}),
  locale,
  cta_id: cta,
});
---

<div class="handoff">
  <div><b>{heading}</b><span>{body}</span></div>
  <div class="handoff-cta-wrap">
    <a
      class="btn on-dark"
      href={href}
      data-wp-event="app_signup_click"
      data-wp-props={props}
      data-checklist-cta={checklist || undefined}
    >
      {action}
    </a>
    {note && <p class="handoff-note">{note}</p>}
  </div>
</div>
