---
/**
 * Primary nav at prototype parity. Content-backed links (Start Here, the
 * Regional Center pillar) render only when their target exists in this
 * build — a production build without published content must not link to
 * pages that 404 (src/lib/content.ts).
 *
 * Mobile: below 860px the nav collapses behind a toggle button instead of
 * flex-wrapping. Seven items wrapped to two rows on a phone-width viewport,
 * and the sticky + backdrop-filter header (position: sticky, blur) made
 * that second row visually smear over the article text scrolling underneath
 * it — reported live on an iPhone. The collapsed nav pushes content down
 * when open rather than overlaying it, so there's no z-index/backdrop
 * interaction to get wrong. No JS = nav stays visible (falls back to the
 * pre-toggle wrapping behavior), so nothing is unreachable without it.
 */
import Brandmark from './Brandmark.astro';
import { visibleContentUrls } from '../lib/content';
import { appStartUrl, slugFromPath, type Pillar } from '../lib/appLinks';

interface Props {
  /** Pillar of the current page (D3: wp_pillar required on pillar content). */
  pillar?: string;
  locale?: 'en' | 'es';
}
const { pillar, locale = 'en' } = Astro.props;

const APP_URL = 'https://app.waypointchild.com';
const urls = await visibleContentUrls();
const path = Astro.url.pathname;
const slug = slugFromPath(path);

// Active-state prefixes mirror the prototype's navMap: guides owns answers
// and letters; Regional Centers owns the entity pages (/regional-centers/*),
// while the pillar guide itself highlights Guides.
const navItems = [
  { label: 'Start Here', href: '/start/', gated: true, active: ['/start/'] },
  { label: 'The App', href: '/product/', gated: false, active: ['/product/'] },
  { label: 'Guides', href: '/guides/', gated: false, active: ['/guides/', '/answers/', '/letters/'] },
  { label: 'Free Tools', href: '/tools/ssi-deeming-calculator/', gated: false, active: ['/tools/'] },
  { label: 'Schools', href: '/guides/iep/', gated: true, active: ['/guides/iep/'] },
  { label: 'Regional Centers', href: '/guides/regional-centers/', gated: true, active: ['/regional-centers/'] },
  { label: 'Pricing', href: '/pricing/', gated: false, active: ['/pricing/'] },
  // Search appears once there is content to search (the index is skipped on
  // builds with zero article pages — scripts/pagefind-index.mjs).
  ...(urls.size > 0 ? [{ label: 'Search', href: '/search/', gated: false, active: ['/search/'] }] : []),
].filter((item) => !item.gated || urls.has(item.href));

const isActive = (item: { active: string[] }) => item.active.some((p) => path.startsWith(p));

const ctaHref = appStartUrl({ slug, cta: 'header', locale, pillar: pillar as Pillar | undefined });
const ctaProps = JSON.stringify({ slug, ...(pillar ? { pillar } : {}), locale, cta_id: 'header' });
---

<header class="topnav" id="site-header">
  <div class="row">
    <a class="logo" href="/" aria-label="Waypoint home">
      <Brandmark size={30} />
      <span class="word">WAYPOINT</span>
    </a>
    <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="primary-nav">
      <span class="bars" aria-hidden="true"></span>
      <span class="sr-only">Menu</span>
    </button>
    <nav aria-label="Primary" id="primary-nav">
      {
        navItems.map((item) => (
          <a href={item.href} aria-current={isActive(item) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <span class="spacer"></span>
    <a class="login" href={APP_URL}>Log in</a>
    <a class="btn" href={ctaHref} data-wp-event="app_signup_click" data-wp-props={ctaProps}>
      Get started free
    </a>
  </div>
</header>

<script>
  // Progressive enhancement: the .js-nav class is only added once this runs,
  // so with JS disabled the header CSS never switches into collapsed mode —
  // the nav stays visible and wraps, exactly as it did before this toggle
  // existed. Nothing becomes unreachable without JS.
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('primary-nav');
  if (header && toggle && nav) {
    header.classList.add('js-nav');
    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      nav.classList.remove('is-open');
    };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
      nav.classList.toggle('is-open', !open);
    });
    nav.addEventListener('click', (e) => {
      if (e.target instanceof HTMLAnchorElement) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        close();
        toggle.focus();
      }
    });
    // A resize past the mobile breakpoint (e.g. rotating to landscape, or a
    // narrow browser window widened) should not leave the panel stuck open
    // with a stale aria-expanded once the toggle itself disappears.
    const mq = window.matchMedia('(min-width: 861px)');
    mq.addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }
</script>

<style>
  .topnav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 12px 24px;
    max-width: 1160px;
    margin: 0 auto;
    flex-wrap: wrap;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
  }
  .word {
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--color-ink);
    font-size: 17px;
  }
  nav {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }
  nav a {
    color: var(--color-ink-soft);
    text-decoration: none;
    font-size: 14.5px;
    font-weight: 500;
    padding: 4px 2px;
    border-bottom: 2px solid transparent;
  }
  nav a:hover {
    color: var(--color-ink);
  }
  nav a[aria-current='page'] {
    color: var(--color-pine);
    border-bottom-color: var(--color-pine);
    font-weight: 700;
  }
  .spacer {
    flex: 1;
  }
  .login {
    font-size: 14px;
    color: var(--color-ink-soft);
    text-decoration: none;
    font-weight: 500;
  }
  .btn {
    display: inline-block;
    background: var(--color-pine);
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
    font-size: 13.5px;
    border-radius: 12px;
    padding: 9px 16px;
  }
  .btn:hover,
  .btn:active {
    background: var(--color-pine-deep);
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    margin-left: -8px;
    border: none;
    background: transparent;
    border-radius: 8px;
    cursor: pointer;
  }
  .nav-toggle:hover {
    background: var(--color-panel);
  }
  .bars,
  .bars::before,
  .bars::after {
    display: block;
    position: absolute;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-ink);
    transition:
      transform 0.15s ease,
      opacity 0.15s ease,
      top 0.15s ease;
  }
  .bars {
    position: relative;
  }
  .bars::before,
  .bars::after {
    content: '';
    left: 0;
  }
  .bars::before {
    top: -6px;
  }
  .bars::after {
    top: 6px;
  }
  .nav-toggle[aria-expanded='true'] .bars {
    background: transparent;
  }
  .nav-toggle[aria-expanded='true'] .bars::before {
    top: 0;
    transform: rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .bars::after {
    top: 0;
    transform: rotate(-45deg);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Collapsed mobile nav — only takes effect once JS has confirmed it can
     drive the toggle (site-header.js-nav, added on load). Without JS the
     nav keeps the original always-visible, wrapping behavior below. */
  @media (max-width: 860px) {
    .topnav.js-nav .nav-toggle {
      display: inline-flex;
    }
    .topnav.js-nav nav[aria-label='Primary'] {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      gap: 0;
      padding-top: 4px;
      border-top: 1px solid var(--color-border);
      margin-top: 8px;
    }
    .topnav.js-nav nav[aria-label='Primary'].is-open {
      display: flex;
    }
    .topnav.js-nav nav[aria-label='Primary'] a {
      padding: 12px 4px;
      border-bottom: 1px solid var(--color-border);
    }
    .topnav.js-nav nav[aria-label='Primary'] a[aria-current='page'] {
      border-bottom-color: var(--color-pine);
    }
  }
</style>
