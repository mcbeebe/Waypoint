---
/**
 * Primary nav at prototype parity. Content-backed links (Start Here, the
 * Regional Center pillar) render only when their target exists in this
 * build — a production build without published content must not link to
 * pages that 404 (src/lib/content.ts).
 */
import Brandmark from './Brandmark.astro';
import { visibleContentUrls } from '../lib/content';
import { appStartUrl, slugFromPath, type Pillar } from '../lib/appLinks';

interface Props {
  /** Pillar of the current page (D3: wp_pillar required on pillar content). */
  pillar?: string;
  locale?: 'en' | 'es';
}
const { pillar, locale = 'en' } = Astro.props;

const APP_URL = 'https://app.waypointchild.com';
const urls = await visibleContentUrls();
const path = Astro.url.pathname;
const slug = slugFromPath(path);

// Active-state prefixes mirror the prototype's navMap: guides owns answers
// and letters; Regional Centers owns the entity pages (/regional-centers/*),
// while the pillar guide itself highlights Guides.
const navItems = [
  { label: 'Start Here', href: '/start/', gated: true, active: ['/start/'] },
  { label: 'Guides', href: '/guides/', gated: false, active: ['/guides/', '/answers/', '/letters/'] },
  { label: 'Free Tools', href: '/tools/ssi-deeming-calculator/', gated: false, active: ['/tools/'] },
  { label: 'Schools', href: '/guides/iep/', gated: true, active: ['/guides/iep/'] },
  { label: 'Regional Centers', href: '/guides/regional-centers/', gated: true, active: ['/regional-centers/'] },
  { label: 'Pricing', href: '/pricing/', gated: false, active: ['/pricing/'] },
  // Search appears once there is content to search (the index is skipped on
  // builds with zero article pages — scripts/pagefind-index.mjs).
  ...(urls.size > 0 ? [{ label: 'Search', href: '/search/', gated: false, active: ['/search/'] }] : []),
].filter((item) => !item.gated || urls.has(item.href));

const isActive = (item: { active: string[] }) => item.active.some((p) => path.startsWith(p));

const ctaHref = appStartUrl({ slug, cta: 'header', locale, pillar: pillar as Pillar | undefined });
const ctaProps = JSON.stringify({ slug, ...(pillar ? { pillar } : {}), locale, cta_id: 'header' });
---

<header class="topnav">
  <div class="row">
    <a class="logo" href="/" aria-label="Waypoint home">
      <Brandmark size={30} />
      <span class="word">WAYPOINT</span>
    </a>
    <nav aria-label="Primary">
      {
        navItems.map((item) => (
          <a href={item.href} aria-current={isActive(item) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <span class="spacer"></span>
    <a class="login" href={APP_URL}>Log in</a>
    <a class="btn" href={ctaHref} data-wp-event="app_signup_click" data-wp-props={ctaProps}>
      Get started free
    </a>
  </div>
</header>

<style>
  .topnav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 12px 24px;
    max-width: 1160px;
    margin: 0 auto;
    flex-wrap: wrap;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
  }
  .word {
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--color-ink);
    font-size: 17px;
  }
  nav {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }
  nav a {
    color: var(--color-ink-soft);
    text-decoration: none;
    font-size: 14.5px;
    font-weight: 500;
    padding: 4px 2px;
    border-bottom: 2px solid transparent;
  }
  nav a:hover {
    color: var(--color-ink);
  }
  nav a[aria-current='page'] {
    color: var(--color-pine);
    border-bottom-color: var(--color-pine);
    font-weight: 700;
  }
  .spacer {
    flex: 1;
  }
  .login {
    font-size: 14px;
    color: var(--color-ink-soft);
    text-decoration: none;
    font-weight: 500;
  }
  .btn {
    display: inline-block;
    background: var(--color-pine);
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
    font-size: 13.5px;
    border-radius: 12px;
    padding: 9px 16px;
  }
  .btn:hover,
  .btn:active {
    background: var(--color-pine-deep);
  }
</style>
