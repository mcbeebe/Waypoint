---
import Brandmark from './Brandmark.astro';
// Phase 0 header: brandmark + primary CTA. The full nav (Start Here, Guides,
// Free Tools, Regional Centers, Pricing) lands in Phase 1 with its routes —
// per the prototype, which is the design source of truth.
const APP_URL = 'https://app.waypointchild.com';
---

<header class="topnav">
  <div class="row">
    <a class="logo" href="/" aria-label="Waypoint home">
      <Brandmark size={30} />
      <span class="word">WAYPOINT</span>
    </a>
    <span class="spacer"></span>
    <span class="lang-chip">EN · ES</span>
    <a class="login" href={APP_URL}>Log in</a>
    <a class="btn" href={`${APP_URL}/start?utm_source=site&utm_medium=organic-content&wp_cta=header`}>Get started free</a>
  </div>
</header>

<style>
  .topnav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 12px 24px;
    max-width: 1160px;
    margin: 0 auto;
    flex-wrap: wrap;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
  }
  .word {
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--color-ink);
    font-size: 17px;
  }
  .spacer {
    flex: 1;
  }
  .lang-chip {
    font-size: 12.5px;
    color: var(--color-ink-faint);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 3px 11px;
    background: var(--color-panel);
  }
  .login {
    font-size: 14px;
    color: var(--color-ink-soft);
    text-decoration: none;
    font-weight: 500;
  }
  .btn {
    display: inline-block;
    background: var(--color-pine);
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
    font-size: 13.5px;
    border-radius: 12px;
    padding: 9px 16px;
  }
  .btn:hover {
    background: var(--color-pine-deep);
  }
  .btn:active {
    background: var(--color-pine-deep);
  }
</style>
