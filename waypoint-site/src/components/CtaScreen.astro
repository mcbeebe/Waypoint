---
/**
 * A small sample app screen beside a guide's call-to-action box (initiative
 * 013, PR 6; mockup approved by the owner 2026-10-09). The screen matches the
 * page's topic. Every card is one the app can produce, worded the way
 * waypoint-app/src/lib/homeTriage.ts words it, with a fictional family.
 *
 * One labelled image to assistive tech; hidden on narrow screens, where the
 * box stays exactly as it was. Divs, not span/b: the global `.handoff span`
 * and `.handoff b` rules would otherwise restyle the screen's text.
 */
import { ctaScreenCard, type CtaScreenKind } from '../lib/ctaScreen';

interface Props {
  kind: CtaScreenKind;
}
const card = ctaScreenCard(Astro.props.kind);
---

<div class="cta-screen" role="img" aria-label={card.label}>
  <div class="cta-screen-in" aria-hidden="true">
    {card.to && <div class="cs-meta">{card.to}</div>}
    {card.pill && <div class:list={['cs-pill', card.pillTone]}>{card.pill}</div>}
    <div class="cs-title">{card.title}</div>
    {card.body && <div class:list={['cs-body', card.boxed && 'cs-boxed']}>{card.body}</div>}
    {card.cite && <div class="cs-meta">{card.cite}</div>}
    <div class="cs-btn">{card.button}</div>
  </div>
</div>

<style>
  .cta-screen {
    flex: 0 0 196px;
    background: #0d1820;
    border-radius: 22px;
    padding: 7px;
  }
  .cta-screen-in {
    background: var(--color-cream);
    color: var(--color-ink);
    border-radius: 16px;
    padding: 10px;
    font-size: 10.5px;
    line-height: 1.4;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .cs-pill {
    align-self: flex-start;
    font-weight: 700;
    font-size: 9px;
    letter-spacing: 0.04em;
    padding: 2px 6px;
    border-radius: 5px;
    background: var(--color-amber-soft);
    color: var(--color-amber);
  }
  .cs-pill.cs-today {
    background: var(--color-pine-tint);
    color: var(--color-pine-deep);
  }
  .cs-title {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-ink);
  }
  .cs-body,
  .cs-meta {
    color: var(--color-ink-soft);
  }
  .cs-boxed {
    background: #ffffff;
    color: var(--color-ink);
    border-radius: 7px;
    padding: 7px;
  }
  .cs-btn {
    background: var(--color-pine);
    color: #ffffff;
    border-radius: 7px;
    padding: 6px;
    text-align: center;
    font-weight: 700;
  }
  @media (max-width: 720px) {
    .cta-screen {
      display: none;
    }
  }
</style>
