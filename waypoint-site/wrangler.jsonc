{
  // Cloudflare Workers static-assets deploy for waypointchild.com.
  // Deploy: `npx wrangler deploy --env preview` (workers.dev) or
  // `npx wrangler deploy --env production` (custom-domain routes — added at
  // cutover, once the zone's nameservers move to Cloudflare; see
  // docs/redirect-map.md). Secrets (CLOUDFLARE_API_TOKEN, ACCOUNT_ID) live in
  // GitHub Actions secrets only.
  "name": "waypoint-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "env": {
    "preview": {},
    "production": {
      // "routes": [{ "pattern": "waypointchild.com", "custom_domain": true }]
      // ^ uncomment at cutover (build-plan Phase 1, week 3)
    }
  }
}
