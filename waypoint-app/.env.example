EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Sentry crash reporting (optional — app works without it)
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google Sign-In + Calendar/Gmail APIs (roadmap 0.3)
# Create OAuth client IDs at https://console.cloud.google.com → APIs & Services → Credentials:
#   1. Create a project (or reuse one) and enable the Google Calendar API and Gmail API
#   2. Configure the OAuth consent screen (External; add calendar + gmail.send scopes)
#   3. Create an OAuth client ID of type "Web application" → EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
#      (add your web app origin to Authorized JavaScript origins)
#   4. Create an OAuth client ID of type "iOS" with bundle id com.waypoint.app
#      → EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID (needed for the native build only)
# Google Sign-In stays hidden in the app until these are set.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Epic FHIR / MyChart (roadmap 6.3 — register at https://fhir.epic.com, see ROADMAP.md)
EXPO_PUBLIC_FHIR_CLIENT_ID=your-epic-client-id

# To set up:
# 1. Create a Supabase project at https://supabase.com
# 2. Copy your Project URL and anon key from Settings → API
# 3. Enable pgvector extension in Database → Extensions
# 4. (Optional) Create a Sentry project at https://sentry.io for crash reporting
# 5. Copy this file to .env and fill in your values
